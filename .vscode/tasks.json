{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ESPuino Complete",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/platformio",
            "args": ["run", "-e", "complete"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
